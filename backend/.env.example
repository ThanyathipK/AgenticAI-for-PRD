# ============================================================
# AgenticDIA backend configuration
# Copy this file to backend/.env and edit the values.
# pydantic-settings loads ".env" from the directory uvicorn is
# launched from (the backend/ folder via `npm run dev`).
# ============================================================

# --- Local LLM (LM Studio) ---
# LM Studio "Developer / Local Server" must be running on :1234
# with an OpenAI-compatible endpoint (/v1). Any loaded model works;
# set LM_STUDIO_MODEL_FALLBACK to the model id shown in LM Studio.
LM_STUDIO_URL="http://localhost:1234/v1"
LM_STUDIO_API_KEY="lm-studio"
LM_STUDIO_MODEL_FALLBACK="qwen/qwen3.5-9b"
LLM_REQUEST_TIMEOUT_SECONDS=600
LLM_STRUCTURED_TOTAL_TIMEOUT_SECONDS=630
LLM_STRUCTURED_PROVIDER_FALLBACK=false
LLM_BACKGROUND_JOB_TIMEOUT_SECONDS=5400
LLM_MAX_CONCURRENT_HEAVY_JOBS=1
AUDITOR_MAX_PASSES=8
# Must match (or be lower than) the context length selected in LM Studio when
# loading the model. Auditor prompt sizing uses the lower of this and
# MAX_CONTEXT_TOKENS, including prompt/schema overhead and completion headroom.
AUDITOR_CONTEXT_TOKENS=8192
AUDITOR_OUTPUT_TOKENS=3000
# Qwen3.x are reasoning models: with thinking left on they can exhaust the whole
# max_tokens budget on reasoning_content and return an empty content, which makes
# every structured-JSON generation (PRD / audit) fail. Set false only if you use
# a non-reasoning model or deliberately want chain-of-thought responses.
LM_STUDIO_DISABLE_THINKING=true

# --- Async-safe context budget injected into every system prompt ---
MAX_CONTEXT_TOKENS=8192
TEMPERATURE=0.0

# --- Document upload & extraction (see app/document_processor.py) ---
# MAX_UPLOAD_MB is the ONLY size gate at save time (it guards disk abuse, not
# tokens); the full converted markdown is always persisted.
MAX_UPLOAD_MB=25
# Chunk size + overlap for chunked document extraction. Bigger chunks => fewer
# gatherer passes => faster extraction for the same content (safe up to roughly
# MAX_CONTEXT_TOKENS - output budget - prompt overhead).
DOCUMENT_BUDGET_FRACTION=0.1
DOCUMENT_CHUNK_SIZE=900
DOCUMENT_CHUNK_OVERLAP=100
DOCUMENT_EXTRACTION_OUTPUT_TOKENS=4000
# Bounded parallel gatherer passes. 1 = fully sequential (safe default for a
# single-slot local model on 16 GB RAM). Raise to 2-4 ONLY when the inference
# gateway can truly serve concurrent requests (LM Studio multi-slot, or a cloud
# OpenAI-compatible endpoint); on a single-slot server they simply queue.
DOCUMENT_EXTRACTION_CONCURRENCY=1

# --- Project knowledge retrieval for General Chat ---
PROJECT_RAG_CHUNK_TOKENS=700
PROJECT_RAG_CHUNK_OVERLAP=100
PROJECT_RAG_TOP_K=5
PROJECT_RAG_MAX_CONTEXT_TOKENS=2500

# --- Application runtime ---
# Boolean flag for uvicorn reload and SQL logging. Common mode names such as
# "development" and "release" are also accepted for IDE compatibility.
DEBUG=false

# --- Rate limiting (Finding #39: guard LLM-facing endpoints) ---
# In-process sliding-window limiter keyed by scope + client IP (per-process).
# Set RATE_LIMIT_ENABLED=false to disable (not recommended in prod).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_LIMIT=30
RATE_LIMIT_CHAT_WINDOW=60
RATE_LIMIT_WORKFLOW_LIMIT=60
RATE_LIMIT_WORKFLOW_WINDOW=60
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_LIMIT=10
RATE_LIMIT_REGISTER_WINDOW=300
# Store backing the limiter. Only "in-process" exists today: that REQUIRES
# exactly one uvicorn worker (uvicorn's default). The app refuses to boot
# with --workers N while this store is in use, so 429 protection can never
# silently scale by worker count.
RATE_LIMIT_STORE="in-process"
# Explicitly accept N workers with the in-process store (each worker keeps an
# independent budget -> weaker posture). The app still warns loudly at startup.
# RATE_LIMIT_ALLOW_MULTI_PROCESS_IN_PROCESS=false
# Behind a reverse proxy / load balancer, trust X-Forwarded-For only from your
# own proxy IPs so every client keeps its own bucket (never widen a bucket by
# sending spoofed headers to an untrusted peer).
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_IPS="127.0.0.1,::1,10.0.0.5"

# --- Database ---
# Postgres URL (auto-converted to asyncpg; ssl=require is appended
# automatically for supabase.com hosts). If left unset the backend
# falls back to a local SQLite file backend/app.db.
# Copying this line WITHOUT replacing <user>/<password> is detected as an
# unfilled placeholder: instead of failing with asyncpg's cryptic
# "tenant/user postgres.[YOUR_PROJECT_REF] not found", the backend logs a
# warning and uses the SQLite fallback (set ALLOW_SQLITE_FALLBACK=false to
# make that a hard startup error instead).
# DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<db>"
#
# SUPABASE (real cloud DB for users + projects):
#   Supabase Dashboard -> Project Settings -> Database -> Connection string ->
#   "Transaction pooler" (port 6543). Paste it here, replacing [YOUR-PASSWORD].
#   The backend auto-runs table migrations + seeds the system account into that
#   database at startup, and TLS is forced automatically (an explicit
#   ?sslmode=... in the URL wins).
#   Example:
# DATABASE_URL="postgresql://postgres.abcdefghij:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# Keep true only for local development. Set false in staging/production so a
# missing or placeholder Supabase URL aborts startup instead of creating app.db.
ALLOW_SQLITE_FALLBACK=true
#
# NOTE: while the value still contains a [YOUR-...] placeholder the backend
# deliberately falls back to the local SQLite file backend/app.db so the app
# keeps running.

# CORS (comma-separated browser origins; never "*" with credentials) ---
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- JWT Authentication ---
# Replace with a strong random secret, e.g. `openssl rand -hex 32`. An empty
# value or an unfilled placeholder falls back to the development secret with
# a startup warning (a placeholder is never silently used as a real secret).
JWT_SECRET_KEY="[YOUR_SECRET_KEY_CHANGE_IN_PRODUCTION]"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=720
# Gate for POST /api/auth/register. Set false in shared/production
# deployments so anonymous callers cannot create accounts (the endpoint then
# answers 403). The UI discovers this via GET /api/auth/config.
SIGNUP_ENABLED=true

# --- Bootstrap system account -------------------------------------------
# Seeded on startup by ``app.migrations.seed_default_user``. This account is
# ALSO the owner (``projects.user_id``) of every project created without an
# authenticated caller, so its id must stay 00000000-0000-0000-0000-000000000000.
# SYSTEM_USER_PASSWORD is required for POST /api/auth/login to work: the value
# is bcrypt-hashed into ``users.password_hash`` on insert, and back-filled onto
# an existing row whose hash is still empty. An already-provisioned password is
# never overwritten after provisioning.
SYSTEM_USER_ID="00000000-0000-0000-0000-000000000000"
SYSTEM_USER_EMAIL="system@banking.com"
SYSTEM_USER_NAME="System User"
SYSTEM_USER_ROLE="Developer"
SYSTEM_USER_PASSWORD="[YOUR_DEV_PASSWORD_CHANGE_ME]"
