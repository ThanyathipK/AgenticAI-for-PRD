{
  "name": "agenticdia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "cd backend && ../venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 & vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "npm run lint:types && npm run lint:eslint && npm run lint:backend",
    "lint:types": "tsc --noEmit",
    "lint:eslint": "eslint src/hooks/chat src/components/MainArtifactPanel.tsx src/components/WorkspaceNavigation.tsx scripts/frontend_workflows.test.ts",
    "lint:backend": "./venv/bin/python -m ruff check backend/app --select E4,E7,E9,F",
    "format:check": "prettier --check src/hooks/chat src/components/MainArtifactPanel.tsx src/components/WorkspaceNavigation.tsx scripts/frontend_workflows.test.ts",
    "format:write": "prettier --write src/hooks/chat src/components/MainArtifactPanel.tsx src/components/WorkspaceNavigation.tsx scripts/frontend_workflows.test.ts",
    "schema:parse": "tsx scripts/parse_check.ts",
    "schema:drift": "./venv/bin/python backend/check_schema_drift.py",
    "inventory:tests": "./venv/bin/python scripts/generate_untested_inventory.py",
    "test": "tsx --test scripts/unit.test.ts scripts/auth.test.ts scripts/requirement_locks.test.ts scripts/frontend_workflows.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.1",
    "lucide-react": "^0.546.0",
    "mermaid": "^12.2.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.2.3"
  }
}
